---
import { url } from '../lib/site';

interface Props {
  studioName: string;
  current: 'home' | 'works' | 'studio';
}
const { studioName, current } = Astro.props;
---

<header class="site-header">
  <div class="wrap bar">
    <nav class="left" aria-label="Main">
      <a href={url('/works/')} aria-current={current === 'works' ? 'page' : undefined}>Works</a>
      <a href={url('/studio/')} aria-current={current === 'studio' ? 'page' : undefined}>Studio</a>
    </nav>
    <a class="name serif" href={url('/')}>{studioName}</a>
    <a class="right" href="#contact">Contact</a>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--rule); }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-block: 20px;
  }
  .left { display: flex; gap: 28px; }
  .left a, .right {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }
  .left a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; }
  .right { justify-self: end; }
  .name {
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    text-align: center;
    line-height: 1.1;
  }

  @media (max-width: 640px) {
    .bar {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'name name' 'left right';
      row-gap: 4px;
      padding-block: 14px 4px;
    }
    .name { grid-area: name; text-align: left; }
    .left { grid-area: left; gap: 20px; }
    .right { grid-area: right; }
  }
</style>
